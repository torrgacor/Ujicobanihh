# Gmail account used to send verification emails. Use a Google App Password,
# not the regular Google account password.
GMAIL_USER=your-account@gmail.com
GMAIL_PASSWORD=your-google-app-password
GMAIL_FROM="TokoPanel <your-account@gmail.com>"

# Public base URL of the deployed app (no trailing slash required).
NEXT_PUBLIC_APP_URL=https://your-domain.example
